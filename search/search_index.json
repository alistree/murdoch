{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#murdoch-university-diploma","title":"\u83ab\u9053\u514b\u5927\u5b66\u6bd5\u4e1a\u8bc1(Murdoch University diploma)\u5b66\u5386\u6587\u51ed\u6a21\u7248\u53c2\u7167","text":"<p>\u5728\u5f53\u524d\u5168\u7403\u5316\u7684\u4eba\u624d\u7ade\u4e89\u4e2d\uff0c\u6d77\u5916\u7559\u5b66\u7ecf\u5386\u5df2\u6210\u4e3a\u4f17\u591a\u6c42\u804c\u8005\u8131\u9896\u800c\u51fa\u7684\u91cd\u8981\u781d\u7801\u3002\u4f5c\u4e3a\u6fb3\u5927\u5229\u4e9a\u77e5\u540d\u7684\u9ad8\u7b49\u5b66\u5e9c\uff0c\u83ab\u9053\u514b\u5927\u5b66\uff08Murdoch University\uff09\u51ed\u501f\u5176\u5353\u8d8a\u7684\u6559\u5b66\u8d28\u91cf\u548c\u521b\u65b0\u7684\u79d1\u7814\u5b9e\u529b\uff0c\u5438\u5f15\u4e86\u5927\u91cf\u56fd\u9645\u7559\u5b66\u751f\u3002\u5bf9\u4e8e\u6bd5\u4e1a\u751f\u800c\u8a00\uff0c\u90a3\u5f20\u8c61\u5f81\u7740\u5b66\u4e1a\u5706\u6ee1\u7684\u5b66\u4f4d\u8bc1\u4e66\u4e0d\u4ec5\u662f\u4e2a\u4eba\u52aa\u529b\u7684\u89c1\u8bc1\uff0c\u66f4\u662f\u8fdb\u5165\u804c\u573a\u3001\u7ee7\u7eed\u6df1\u9020\u6216\u7533\u8bf7\u6d77\u5916\u79fb\u6c11\u65f6\u4e0d\u53ef\u6216\u7f3a\u7684\u6838\u5fc3\u51ed\u8bc1\u3002</p> <p></p> <p>\u968f\u7740\u8de8\u5883\u4eba\u624d\u6d41\u52a8\u7684\u65e5\u76ca\u9891\u7e41\uff0c\u7b2c\u4e09\u65b9\u7528\u4eba\u5355\u4f4d\u3001\u7559\u670d\u8ba4\u8bc1\u673a\u6784\u4ee5\u53ca\u5b66\u672f\u673a\u6784\u5bf9\u6d77\u5916\u6587\u51ed\u7684\u771f\u5b9e\u6027\u4e0e\u89c4\u8303\u6027\u5ba1\u67e5\u4e5f\u6108\u53d1\u4e25\u683c\u3002\u672c\u6587\u5c06\u56f4\u7ed5\u8be5\u6821\u8bc1\u4e66\u7684\u89c6\u89c9\u7279\u5f81\u3001\u9632\u4f2a\u5de5\u827a\u3001\u6838\u5fc3\u4e13\u4e1a\u5e03\u5c40\u4ee5\u53ca\u5728\u56fd\u9645\u4eba\u624d\u5e02\u573a\u4e2d\u7684\u542b\u91d1\u91cf\u8fdb\u884c\u6df1\u5ea6\u5256\u6790\uff0c\u4e3a\u5e7f\u5927\u6821\u53cb\u53ca\u76f8\u5173\u673a\u6784\u63d0\u4f9b\u4e00\u4efd\u8be6\u5c3d\u7684\u53c2\u7167\u6307\u5357\u3002</p>"},{"location":"#_1","title":"\u83ab\u9053\u514b\u5927\u5b66\u5b66\u4f4d\u8bc1\u4e66\u7684\u89c6\u89c9\u8bbe\u8ba1\u4e0e\u6392\u7248\u89c4\u8303","text":"<p>\u4e00\u4efd\u6b63\u89c4\u7684\u6d77\u5916\u5927\u5b66\u6bd5\u4e1a\u8bc1\uff0c\u5176\u8bbe\u8ba1\u8bed\u8a00\u5f80\u5f80\u878d\u5408\u4e86\u5b66\u6821\u7684\u5386\u53f2\u5e95\u8574\u4e0e\u73b0\u4ee3\u9632\u4f2a\u79d1\u6280\u3002\u4ece\u89c6\u89c9\u7f8e\u5b66\u548c\u6392\u7248\u7ed3\u6784\u6765\u770b\uff0c\u8be5\u6821\u7684\u6587\u51ed\u8bc1\u4e66\u5448\u73b0\u51fa\u6781\u9ad8\u7684\u89c4\u8303\u6027\uff1a</p> <ul> <li>\u9876\u90e8\u6821\u5fbd\u4e0e\u54c1\u724c\u6807\u8bc6\uff1a\u8bc1\u4e66\u7684\u6b63\u4e0a\u65b9\u5c45\u4e2d\u4f4d\u7f6e\u5370\u6709\u5b66\u6821\u9c9c\u660e\u7684\u7ea2\u7eff\u76f8\u95f4\u76fe\u5f62\u6821\u5fbd\uff0c\u4e0b\u65b9\u914d\u4ee5\u52a0\u7c97\u7684\u201cMurdoch UNIVERSITY\u201d\u6807\u51c6\u82f1\u6587\u5b57\u4f53\u3002\u6821\u5fbd\u7684\u5370\u5237\u8272\u5f69\u9971\u548c\u5ea6\u9ad8\u3001\u8fb9\u7f18\u6e05\u6670\uff0c\u6574\u4f53\u6784\u56fe\u5e84\u91cd\u800c\u5177\u6709\u5b66\u672f\u5a01\u4e25\u611f\u3002</li> <li>\u6838\u5fc3\u6587\u672c\u533a\uff1a\u8bc1\u4e66\u4e2d\u592e\u91c7\u7528\u4f18\u96c5\u7684\u65e0\u886c\u7ebf\u6216\u4f20\u7edf\u5b66\u672f\u5b57\u4f53\uff0c\u6e05\u6670\u6807\u660e\u6bd5\u4e1a\u751f\u7684\u6cd5\u5b9a\u59d3\u540d\u3001\u6240\u8fbe\u6210\u7684\u5b66\u672f\u6210\u5c31\uff08\u5982\u6ee1\u8db3\u6cd5\u5f8b\u4e0e\u7ae0\u7a0b\u7684\u6240\u6709\u8981\u6c42\uff09\uff0c\u5e76\u4ee5\u9192\u76ee\u7684\u5b57\u53f7\u6807\u51fa\u6388\u4e88\u7684\u5b66\u4f4d\u540d\u79f0\uff08\u4f8b\u5982\uff1a\u5168\u7403\u5b89\u5168\u3001\u6050\u6016\u4e3b\u4e49\u4e0e\u53cd\u6050\u7814\u7a76\u5b66\u58eb\u5b66\u4f4d\uff09\u3002</li> <li>\u5e95\u90e8\u5370\u9274\u4e0e\u7b7e\u7ae0\uff1a\u8bc1\u4e66\u5de6\u4e0b\u65b9\u538b\u5370\u6709\u7acb\u4f53\u611f\u6781\u5f3a\u7684\u91d1\u5c5e\u8d28\u611f\u9f7f\u8f6e\u72b6\u94a2\u5370\uff0c\u94a2\u5370\u4e2d\u5fc3\u540c\u6837\u4e3a\u5b66\u6821\u7684\u6807\u5fd7\u6027\u6821\u5fbd\uff1b\u53f3\u4e0b\u65b9\u5219\u7531\u5b66\u6821\u9ad8\u5c42\u5b98\u5458\uff08\u5982 Chancellor \u9996\u5e2d\u6821\u8463\u3001Vice Chancellor \u526f\u6821\u957f\uff09\u8fdb\u884c\u4eb2\u7b14\u624b\u5199\u7b7e\u540d\u6216\u9ad8\u7cbe\u5ea6\u6570\u5b57\u5316\u7b7e\u7ae0\u3002</li> <li>\u843d\u6b3e\u4e0e\u7f16\u53f7\uff1a\u6700\u5e95\u90e8\u660e\u786e\u8bb0\u8f7d\u4e86\u8bc1\u4e66\u7684\u9881\u53d1\u5730\u70b9\uff08\u897f\u6fb3\u5927\u5229\u4e9a\u5dde\u73c0\u65af\uff09\u3001\u9881\u53d1\u65f6\u95f4\uff08\u7cbe\u786e\u5230\u5177\u4f53\u65e5\u671f\uff0c\u59822025\u5e741\u670829\u65e5\uff09\u4ee5\u53ca\u552f\u4e00\u7684\u6bd5\u4e1a\u751f\u6ce8\u518c\u6216\u8bc1\u4e66\u7f16\u53f7\uff08Graduate Number\uff09\uff0c\u786e\u4fdd\u6bcf\u4efd\u6587\u4ef6\u7684\u552f\u4e00\u6027\u4e0e\u53ef\u8ffd\u6eaf\u6027\u3002</li> </ul>"},{"location":"#_2","title":"\u6838\u5fc3\u4e13\u4e1a\u89e3\u6790\uff1a\u4ee5\u5168\u7403\u5b89\u5168\u4e0e\u53cd\u6050\u7814\u7a76\u4e3a\u4f8b","text":"<p>\u5728\u4e0a\u8ff0\u8bc1\u4e66\u6a21\u7248\u4e2d\uff0c\u6211\u4eec\u53ef\u4ee5\u770b\u5230\u4e00\u4e2a\u6781\u5177\u524d\u6cbf\u6027\u548c\u65f6\u4ee3\u7279\u8272\u7684\u4e13\u4e1a\u2014\u2014\u5168\u7403\u5b89\u5168\u3001\u6050\u6016\u4e3b\u4e49\u4e0e\u53cd\u6050\u7814\u7a76\u5b66\u58eb\u5b66\u4f4d\uff08Bachelor of Global Security in Terrorism and Counterterrorism Studies\uff09\u3002\u8fd9\u4e5f\u4ece\u4fa7\u9762\u53cd\u6620\u4e86\u8be5\u6821\u5728\u8bfe\u7a0b\u8bbe\u7f6e\u4e0a\u7684\u524d\u77bb\u6027\u3002</p>"},{"location":"#1","title":"1. \u8bfe\u7a0b\u7814\u53d1\u7684\u65f6\u4ee3\u80cc\u666f","text":"<p>\u5728\u5f53\u4eca\u5730\u7f18\u653f\u6cbb\u590d\u6742\u591a\u53d8\u3001\u7f51\u7edc\u5b89\u5168\u5a01\u80c1\u65e5\u76ca\u4e25\u5cfb\u7684\u80cc\u666f\u4e0b\uff0c\u4f20\u7edf\u7684\u5b89\u5168\u6982\u5ff5\u5df2\u7ecf\u65e0\u6cd5\u6db5\u76d6\u73b0\u4ee3\u793e\u4f1a\u9762\u4e34\u7684\u6311\u6218\u3002\u8be5\u6821\u7d27\u8ddf\u56fd\u9645\u5f62\u52bf\uff0c\u5f00\u8bbe\u4e86\u8fd9\u4e00\u6781\u5177\u9488\u5bf9\u6027\u7684\u8de8\u5b66\u79d1\u4e13\u4e1a\uff0c\u65e8\u5728\u57f9\u517b\u80fd\u591f\u5e94\u5bf9\u975e\u4f20\u7edf\u5b89\u5168\u5a01\u80c1\u7684\u590d\u5408\u578b\u4e13\u5bb6\u3002</p>"},{"location":"#2","title":"2. \u6838\u5fc3\u6559\u5b66\u6a21\u5757","text":"<p>\u8be5\u4e13\u4e1a\u7684\u5b66\u751f\u4e0d\u4ec5\u9700\u8981\u5b66\u4e60\u653f\u6cbb\u5b66\u3001\u56fd\u9645\u5173\u7cfb\u5b66\u3001\u72af\u7f6a\u5b66\u7b49\u57fa\u7840\u7406\u8bba\uff0c\u8fd8\u8981\u6df1\u5165\u94bb\u7814\u53cd\u6050\u7b56\u7565\u3001\u60c5\u62a5\u6536\u96c6\u4e0e\u5206\u6790\u3001\u5371\u673a\u7ba1\u7406\u4ee5\u53ca\u8de8\u56fd\u72af\u7f6a\u9884\u9632\u3002\u5b66\u6821\u901a\u8fc7\u5f15\u5165\u771f\u5b9e\u7684\u6848\u4f8b\u5206\u6790\u548c\u6a21\u62df\u6f14\u7ec3\uff0c\u8ba9\u5b66\u751f\u5728\u5c31\u8bfb\u671f\u95f4\u5c31\u80fd\u63a5\u89e6\u5230\u4e00\u7ebf\u7684\u884c\u4e1a\u52a8\u6001\u3002</p>"},{"location":"#3","title":"3. \u591a\u5143\u7684\u5c31\u4e1a\u53bb\u5411","text":"<p>\u7531\u4e8e\u8bfe\u7a0b\u7684\u5b9e\u7528\u6027\u6781\u9ad8\uff0c\u8be5\u4e13\u4e1a\u7684\u6bd5\u4e1a\u751f\u5728\u56fd\u9645\u5c31\u4e1a\u5e02\u573a\u4e0a\u6781\u5177\u7ade\u4e89\u529b\u3002\u4ed6\u4eec\u7684\u4e3b\u8981\u53bb\u5411\u5305\u62ec\uff1a * \u56fd\u5bb6\u5b89\u5168\u4e0e\u60c5\u62a5\u673a\u6784 * \u653f\u5e9c\u5916\u4ea4\u4e0e\u9632\u52a1\u90e8\u95e8 * \u8de8\u56fd\u4f01\u4e1a\u98ce\u9669\u8bc4\u4f30\u4e0e\u5b89\u5168\u4fdd\u969c\u90e8\u95e8 * \u56fd\u9645\u975e\u653f\u5e9c\u7ec4\u7ec7\uff08NGO\uff09\u53ca\u667a\u5e93\u673a\u6784 * \u7f51\u7edc\u5b89\u5168\u4e0e\u5927\u6570\u636e\u5206\u6790\u516c\u53f8</p>"},{"location":"#_3","title":"\u56fd\u9645\u6587\u51ed\u7684\u9632\u4f2a\u6280\u672f\u4e0e\u5408\u89c4\u6027\u5ba1\u67e5","text":"<p>\u968f\u7740\u6570\u5b57\u5316\u529e\u516c\u7684\u666e\u53ca\uff0c\u6587\u51ed\u7684\u9632\u4f2a\u4e0e\u9a8c\u8bc1\u6280\u672f\u4e5f\u5728\u4e0d\u65ad\u5347\u7ea7\u3002\u4e3a\u4e86\u786e\u4fdd\u5b66\u672f\u6210\u679c\u7684\u4e25\u8083\u6027\uff0c\u6b63\u5f0f\u7684\u6d77\u5916\u5b66\u4f4d\u8bc1\u4e66\u901a\u5e38\u5305\u542b\u591a\u91cd\u8089\u773c\u53ef\u89c1\u53ca\u4e0d\u53ef\u89c1\u7684\u9632\u4f2a\u8bbe\u8ba1\uff1a</p> <ul> <li>\u7279\u5236\u5b89\u5168\u7eb8\u5f20\uff1a\u6b63\u89c4\u6587\u51ed\u91c7\u7528\u7684\u662f\u5177\u6709\u7279\u6b8a\u7eb9\u7406\u548c\u514b\u91cd\u7684\u9632\u4f2a\u5b89\u5168\u7eb8\uff0c\u624b\u611f\u539a\u5b9e\uff0c\u5728\u7d2b\u5916\u7ebf\u706f\u4e0b\u5f80\u5f80\u80fd\u5448\u73b0\u51fa\u7279\u5b9a\u7684\u8367\u5149\u6697\u7eb9\u6216\u6c34\u5370\u3002</li> <li>\u9ad8\u7cbe\u5ea6\u94a2\u5370\u4e0e\u5168\u606f\u6280\u672f\uff1a\u8bc1\u4e66\u4e0a\u7684\u91d1\u5c5e\u94a2\u5370\u91c7\u7528\u51f8\u7248\u538b\u5370\u5de5\u827a\uff0c\u8fb9\u7f18\u9510\u5229\uff0c\u51f9\u51f8\u611f\u660e\u663e\u3002\u90e8\u5206\u5e74\u4efd\u7684\u8bc1\u4e66\u8fd8\u4f1a\u5f15\u5165\u5168\u606f\u9632\u4f2a\u6807\u7b7e\uff0c\u4ece\u4e0d\u540c\u89d2\u5ea6\u770b\u4f1a\u6298\u5c04\u51fa\u4e0d\u540c\u7684\u8272\u5f69\u4e0e\u56fe\u6848\u3002</li> <li>\u5fae\u7f29\u6587\u5b57\u5370\u5237\uff1a\u5728\u8bc1\u4e66\u7684\u67d0\u4e9b\u8fb9\u6846\u6216\u7ebf\u6761\u4e2d\uff0c\u5b9e\u9645\u4e0a\u662f\u7531\u6781\u5c0f\u7684\u5fae\u7f29\u82f1\u6587\u5b57\u6bcd\uff08\u5982\u5b66\u6821\u540d\u79f0\uff09\u8fde\u7f00\u800c\u6210\uff0c\u666e\u901a\u590d\u5370\u673a\u6216\u4f4e\u7cbe\u5ea6\u6253\u5370\u673a\u5728\u590d\u5236\u65f6\u4f1a\u81ea\u52a8\u6a21\u7cca\u6210\u4e00\u6761\u5b9e\u7ebf\u3002</li> <li>\u5b98\u65b9\u5728\u7ebf\u6570\u636e\u5e93\u9a8c\u8bc1\uff1a\u9664\u4e86\u7269\u7406\u9632\u4f2a\uff0c\u73b0\u4ee3\u9ad8\u6821\u666e\u904d\u5f00\u901a\u4e86\u6bd5\u4e1a\u751f\u5728\u7ebf\u9a8c\u8bc1\u7cfb\u7edf\u3002\u7528\u4eba\u5355\u4f4d\u5728\u83b7\u5f97\u5b66\u751f\u6388\u6743\u540e\uff0c\u53ef\u901a\u8fc7\u5b66\u6821\u5b98\u65b9\u7684\u201cGraduation Verification\u201d\u7cfb\u7edf\u8f93\u5165\u5b66\u751f\u59d3\u540d\u4e0e\u8bc1\u4e66\u7f16\u53f7\uff0c\u76f4\u63a5\u6838\u5b9e\u6587\u51ed\u7684\u771f\u5b9e\u6027\u3002</li> </ul>"},{"location":"#_4","title":"\u7559\u5b66\u6587\u51ed\u5728\u8de8\u5883\u4eba\u624d\u5e02\u573a\u4e2d\u7684\u4ef7\u503c\u4e0e\u8ba4\u8bc1\u6d41\u7a0b","text":"<p>\u83b7\u5f97\u6d77\u5916\u6587\u51ed\u53ea\u662f\u7b2c\u4e00\u6b65\uff0c\u5982\u4f55\u8ba9\u8fd9\u4efd\u5b66\u672f\u6210\u679c\u5728\u4e0d\u540c\u7684\u56fd\u5bb6\u548c\u5730\u533a\u53d1\u6325\u6700\u5927\u7684\u6cd5\u5f8b\u4e0e\u5546\u4e1a\u4ef7\u503c\uff0c\u624d\u662f\u6bd5\u4e1a\u751f\u6700\u4e3a\u5173\u5fc3\u7684\u6838\u5fc3\u95ee\u9898\u3002</p>"},{"location":"#1_1","title":"1. \u8de8\u56fd\u5b66\u5386\u5b66\u4f4d\u8ba4\u8bc1","text":"<p>\u5bf9\u4e8e\u56de\u56fd\u53d1\u5c55\u7684\u7559\u5b66\u751f\u800c\u8a00\uff0c\u5b8c\u6210\u5b98\u65b9\u7684\u5b66\u5386\u5b66\u4f4d\u8ba4\u8bc1\u662f\u8fdb\u5165\u56fd\u4f01\u3001\u4e8b\u4e1a\u5355\u4f4d\u3001\u9ad8\u7b49\u9662\u6821\u4ee5\u53ca\u7533\u8bf7\u5404\u7c7b\u653f\u5e9c\u4eba\u624d\u8865\u8d34\u7684\u201c\u6572\u95e8\u7816\u201d\u3002\u8fd9\u4e00\u6d41\u7a0b\u901a\u5e38\u9700\u8981\u6bd5\u4e1a\u751f\u63d0\u4ea4\u5b66\u4f4d\u8bc1\u4e66\u539f\u4ef6\u3001\u62a4\u7167\u7b7e\u8bc1\u8bb0\u5f55\u3001\u6210\u7ee9\u5355\u7b49\u6750\u6599\uff0c\u7531\u6743\u5a01\u6559\u80b2\u673a\u6784\u5bf9\u8bc1\u4e66\u7684\u771f\u5b9e\u6027\u53ca\u5c31\u8bfb\u9662\u6821\u7684\u8d44\u8d28\u8fdb\u884c\u5168\u9762\u8bc4\u4f30\uff0c\u5e76\u51fa\u5177\u5177\u6709\u6cd5\u5f8b\u6548\u529b\u7684\u8ba4\u8bc1\u4e66\u3002</p>"},{"location":"#2_1","title":"2. \u5b66\u5206\u8854\u63a5\u4e0e\u56fd\u9645\u8ba4\u53ef\u5ea6","text":"<p>\u4f5c\u4e3a\u4e00\u6240\u83b7\u5f97\u56fd\u9645\u5e7f\u6cdb\u8ba4\u53ef\u7684\u5927\u5b66\uff0c\u5176\u9881\u53d1\u7684\u6587\u51ed\u4e0d\u4ec5\u5728\u6fb3\u5927\u5229\u4e9a\u672c\u571f\u5177\u6709\u6781\u9ad8\u542b\u91d1\u91cf\uff0c\u5728\u82f1\u8054\u90a6\u56fd\u5bb6\u3001\u6b27\u7f8e\u4ee5\u53ca\u4e9a\u6d32\u4e3b\u6d41\u5e02\u573a\u540c\u6837\u4eab\u6709\u5f88\u9ad8\u7684\u5b66\u672f\u58f0\u8a89\u3002\u8fd9\u4e3a\u6bd5\u4e1a\u751f\u5728\u5168\u7403\u8303\u56f4\u5185\u7533\u8bf7\u7855\u58eb/\u535a\u58eb\u6df1\u9020\uff0c\u6216\u8005\u8f6c\u6362\u804c\u4e1a\u8d5b\u9053\u63d0\u4f9b\u4e86\u6781\u4e3a\u4fbf\u5229\u7684\u901a\u9053\u3002</p>"},{"location":"#3_1","title":"3. \u804c\u573a\u7ade\u4e89\u529b\u8f6c\u5316","text":"<p>\u4e00\u4efd\u89c4\u8303\u3001\u771f\u5b9e\u7684\u6d77\u5916\u6587\u51ed\u80cc\u540e\uff0c\u6298\u5c04\u51fa\u7684\u662f\u6bd5\u4e1a\u751f\u5728\u8de8\u6587\u5316\u6c9f\u901a\u3001\u72ec\u7acb\u7814\u7a76\u3001\u6279\u5224\u6027\u601d\u7ef4\u4ee5\u53ca\u4e13\u4e1a\u82f1\u8bed\u5e94\u7528\u65b9\u9762\u7684\u7efc\u5408\u80fd\u529b\u3002\u5728\u6c42\u804c\u8fc7\u7a0b\u4e2d\uff0c\u6e05\u6670\u3001\u5b8c\u6574\u5730\u5c55\u793a\u81ea\u5df1\u7684\u5b66\u4f4d\u8bc1\u4e66\u53ca\u6210\u7ee9\u5355\uff0c\u5e76\u80fd\u7528\u6d41\u7545\u7684\u8bed\u8a00\u9610\u8ff0\u81ea\u5df1\u5728\u6821\u671f\u95f4\u7684\u79d1\u7814\u9879\u76ee\u6216\u5b9e\u4e60\u7ecf\u5386\uff0c\u662f\u6253\u52a8\u8de8\u56fd\u4f01\u4e1aHR\u7684\u6838\u5fc3\u5173\u952e\u3002</p>"},{"location":"#_5","title":"\u603b\u7ed3","text":"<p>\u83ab\u9053\u514b\u5927\u5b66\u7684\u6bd5\u4e1a\u8bc1\u4e66\u4e0d\u4ec5\u662f\u4e00\u5f20\u7cbe\u7f8e\u7684\u7eb8\u5f20\uff0c\u66f4\u662f\u7559\u5b66\u751f\u6570\u5e74\u5bd2\u7a97\u82e6\u8bfb\u3001\u514b\u670d\u8de8\u6587\u5316\u969c\u788d\u6240\u6362\u6765\u7684\u5b9d\u8d35\u8d22\u5bcc\u3002\u65e0\u8bba\u662f\u8bc1\u4e66\u4e0a\u5e84\u4e25\u7684\u6821\u5fbd\u3001\u7cbe\u81f4\u7684\u94a2\u5370\uff0c\u8fd8\u662f\u542b\u91d1\u91cf\u6781\u9ad8\u7684\u4e13\u4e1a\u540d\u79f0\uff0c\u90fd\u627f\u8f7d\u7740\u5b66\u672f\u7684\u4e25\u8c28\u4e0e\u793e\u4f1a\u7684\u8ba4\u53ef\u3002\u4e86\u89e3\u5176\u6807\u51c6\u7684\u6a21\u7248\u6784\u9020\u3001\u9632\u4f2a\u7279\u5f81\u4ee5\u53ca\u80cc\u540e\u7684\u4e13\u4e1a\u4ef7\u503c\uff0c\u4e0d\u4ec5\u6709\u52a9\u4e8e\u6bd5\u4e1a\u751f\u59a5\u5584\u4fdd\u7ba1\u548c\u4f7f\u7528\u81ea\u5df1\u7684\u5b66\u672f\u51ed\u8bc1\uff0c\u4e5f\u80fd\u4e3a\u4f01\u4e1a\u548c\u8ba4\u8bc1\u673a\u6784\u5728\u8fdb\u884c\u4eba\u624d\u9009\u62d4\u4e0e\u8d44\u8d28\u5ba1\u6838\u65f6\uff0c\u63d0\u4f9b\u4e00\u4efd\u5ba2\u89c2\u3001\u51c6\u786e\u7684\u53c2\u8003\u4f9d\u636e\u3002\u901a\u8fc7\u672c\u6587\u5c55\u793a\u7684\u6821\u5fbd\u6392\u7248\u3001\u7279\u6b8a\u659c\u4f53\u6587\u672c\u3001\u7329\u7ea2\u94a2\u5370\u4ee5\u53ca\u5168\u606f\u9632\u4f2a\u56fe\u5c42\u7b49\u6807\u51c6\u6837\u5f0f\u7684\u5bf9\u7167\uff0c\u76f8\u4fe1\u80fd\u5e2e\u52a9\u60a8\u66f4\u52a0\u6e05\u6670\u3001\u76f4\u89c2\u5730\u4e86\u89e3\u83ab\u7eb3\u4ec0\u5927\u5b66\u5b66\u5386\u6587\u51ed\u7684\u771f\u5b9e\u98ce\u8c8c\u3002</p>"}]}